---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path of this page, starting with a slash. */
  path: string;
  /** Absolute URL of the social preview image. */
  ogImage?: string;
  /** Twitter card type. Use summary_large_image with a 1200x630 ogImage. */
  twitterCard?: 'summary' | 'summary_large_image';
  /** Which header link is the current section. */
  current?: 'services' | 'products' | 'approach';
}

const site = 'https://faulkner.engineering';
const {
  title,
  description,
  path,
  ogImage = `${site}/faulkner-engineering-favicon.png`,
  twitterCard = 'summary',
  current,
} = Astro.props;
const canonical = `${site}${path}`;
const year = new Date().getFullYear();
const onHome = path === '/';
const link = (anchor: string) => (onHome ? `#${anchor}` : `/#${anchor}`);
---

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="Faulkner Engineering LLC">
  <meta name="theme-color" content="#0c0c0d">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="canonical" href={canonical}>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:site_name" content="Faulkner Engineering LLC">
  <meta property="og:image" content={ogImage}>

  <!-- Twitter -->
  <meta name="twitter:card" content={twitterCard}>
  <meta name="twitter:url" content={canonical}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImage}>

  <slot name="head" />
</head>
<body class="min-h-screen">

  <!-- Background grid -->
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 bg-grid"></div>

  <!-- Header -->
  <header class="sticky top-0 z-30 border-b border-line/70 bg-ink/80 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
      <a href={onHome ? '#top' : '/'} class="flex items-center gap-2.5 font-semibold tracking-tight">
        <img src="/favicon.svg" alt="" class="h-7 w-7" width="28" height="28">
        <span>Faulkner Engineering</span>
      </a>
      <nav class="flex items-center gap-6 text-sm text-muted">
        <a href={link('services')} class:list={['hidden hover:text-fg sm:inline', { 'text-fg': current === 'services' }]}>Services</a>
        <a href="/hyperharbor" class:list={['hidden hover:text-fg sm:inline', { 'text-fg': current === 'products' }]}>Products</a>
        <a href={link('approach')} class:list={['hidden hover:text-fg sm:inline', { 'text-fg': current === 'approach' }]}>Approach</a>
        <a href={link('contact')} class="rounded-full border border-line px-4 py-1.5 text-fg transition-colors hover:border-accent hover:text-accent">Contact</a>
      </nav>
    </div>
  </header>

  <main id="top">
    <slot />
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col justify-between gap-2 px-4 py-8 font-mono text-xs text-dim sm:flex-row sm:px-6">
      <p>© {year} Faulkner Engineering LLC</p>
      <p>Based in the United States · Working remotely</p>
    </div>
  </footer>

<style>
  .bg-grid {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 30%, transparent 100%);
  }
</style>
</body>
</html>
