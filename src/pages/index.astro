---
import Site from '../layouts/Site.astro';

const repo = 'https://github.com/faulkner-engineering/hyperharbor';

const hyperharborFeatures = [
  'One-click Remote Desktop to Windows & Linux VMs',
  'PIN pairing, then mutual TLS',
  'Wake-on-LAN with readiness checks',
  'VM create, backup, and move between hosts',
];

const principles = [
  { title: 'Build in the open', body: 'Source on GitHub, Apache 2.0, releases tagged and signed. If it is worth shipping, it is worth reading.' },
  { title: 'Ship small, ship often', body: 'Short releases with a changelog you can actually read. Big rewrites are how projects go quiet.' },
  { title: 'Use it ourselves first', body: 'Every product starts as a tool we needed and run daily. If it annoys us, it gets fixed before it annoys you.' },
  { title: 'Respect the machine', body: 'No telemetry, no accounts you did not ask for, nothing phoning home. Your hardware stays yours.' },
];

const services = [
  {
    n: '01',
    title: 'Data platform architecture',
    body: 'Lakehouse and warehouse designs that fit how your business actually uses data, not how a vendor demo does.',
  },
  {
    n: '02',
    title: 'Pipelines & ingestion',
    body: 'Batch and streaming ingestion that is observable, idempotent, and boring in the best way.',
  },
  {
    n: '03',
    title: 'Applied AI',
    body: 'Practical AI built on clean data: retrieval, automation, and analytics that ship past the prototype.',
  },
  {
    n: '04',
    title: 'Team enablement',
    body: 'Workshops and pairing so your engineers own the system after the engagement ends.',
  },
];

const stack = ['.NET', 'Tauri', 'Rust', 'TypeScript', 'Hyper-V', 'Windows', 'PowerShell', 'Azure', 'GitHub Actions'];
---

<Site
  title="Faulkner Engineering LLC | Software for people who run their own machines"
  description="Faulkner Engineering LLC builds open source software for people who run their own hardware. HyperHarbor turns a Windows PC into a home for your virtual machines. Consulting available for data platforms and applied AI."
  path="/"
  current="products"
>
  <Fragment slot="head">
    <meta name="keywords" content="HyperHarbor, Hyper-V, virtual machines, home lab, self-hosted, open source, Windows, remote desktop, data engineering, solution architecture">
    <!-- Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Faulkner Engineering LLC",
      "description": "Open source software for people who run their own machines, plus consulting for data platforms and applied AI.",
      "url": "https://faulkner.engineering",
      "email": "contact@faulkner.engineering",
      "areaServed": "United States",
      "makesOffer": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "SoftwareApplication",
            "name": "HyperHarbor",
            "applicationCategory": "UtilitiesApplication",
            "operatingSystem": "Windows 11",
            "url": "https://faulkner.engineering/hyperharbor",
            "license": "https://www.apache.org/licenses/LICENSE-2.0"
          },
          "price": "0",
          "priceCurrency": "USD"
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "serviceType": ["Data Engineering", "Solution Architecture", "AI Consulting", "Engineering Education"]
          }
        }
      ]
    }
    </script>
  </Fragment>

    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-4 pb-20 pt-16 sm:px-6 sm:pt-24 lg:pb-28">
      <div class="grid items-center gap-12 lg:grid-cols-[1.25fr_1fr]">
        <div>
          <p class="mb-6 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
            </span>
            Open source · Apache 2.0
          </p>
          <h1 class="text-4xl font-semibold leading-[1.05] tracking-tight text-balance sm:text-6xl">
            Software for people who run their own&nbsp;machines.
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted text-pretty">
            Faulkner Engineering builds tools for home labs and small teams. Our first, HyperHarbor, turns a Windows PC you already own into a home for your virtual machines, reachable in one click from any device.
          </p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href="/hyperharbor" class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-ink transition-opacity hover:opacity-90">
              Get HyperHarbor
            </a>
            <a href={repo} class="rounded-full border border-line px-6 py-3 text-sm font-semibold transition-colors hover:border-fg/40">
              View on GitHub
            </a>
          </div>
        </div>

        <!-- Blueprint panel -->
        <div aria-hidden="true" class="overflow-hidden rounded-2xl border border-accent/30 bg-panel/60 shadow-2xl shadow-black/40">
          <svg viewBox="0 0 520 440" class="w-full" fill="none" stroke="#c8f560" stroke-width="1" font-family="ui-monospace, monospace" font-size="10">
            <defs>
              <pattern id="bp" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M20 0H0V20" stroke="#c8f560" stroke-opacity="0.08"/>
              </pattern>
            </defs>
            <rect width="520" height="440" fill="url(#bp)"/>

            <!-- Tower PC, front and side -->
            <g transform="translate(70 70)">
              <rect x="0" y="0" width="120" height="240" rx="4"/>
              <rect x="12" y="14" width="96" height="6" fill="#c8f560" fill-opacity="0.25" stroke="none"/>
              <rect x="12" y="30" width="96" height="6" fill="#c8f560" fill-opacity="0.25" stroke="none"/>
              <circle cx="100" cy="222" r="3" fill="#c8f560" stroke="none" class="led"/>
              <rect x="12" y="60" width="96" height="140" stroke-dasharray="3 3"/>
              <text x="60" y="124" text-anchor="middle" fill="#c8f560" stroke="none">HYPER-V</text>
              <text x="60" y="138" text-anchor="middle" fill="#c8f560" stroke="none" fill-opacity="0.6">4 × VM</text>
              <!-- dimensions -->
              <line x1="0" y1="258" x2="120" y2="258"/>
              <line x1="0" y1="252" x2="0" y2="264"/><line x1="120" y1="252" x2="120" y2="264"/>
              <text x="60" y="275" text-anchor="middle" fill="#c8f560" stroke="none">YOUR PC</text>
              <line x1="-18" y1="0" x2="-18" y2="240"/>
              <line x1="-24" y1="0" x2="-12" y2="0"/><line x1="-24" y1="240" x2="-12" y2="240"/>
              <text transform="translate(-30 120) rotate(-90)" text-anchor="middle" fill="#c8f560" stroke="none">ALREADY OWNED</text>
            </g>

            <!-- Laptop -->
            <g transform="translate(300 90)">
              <rect x="0" y="0" width="150" height="90" rx="3"/>
              <rect x="8" y="8" width="134" height="70" stroke-dasharray="3 3"/>
              <path d="M-12 96 H162 L154 108 H-4 Z"/>
              <text x="75" y="48" text-anchor="middle" fill="#c8f560" stroke="none">ANY DEVICE</text>
            </g>

            <!-- Connection -->
            <path d="M190 190 C 240 190, 250 140, 300 140" stroke-dasharray="4 4" class="flow"/>
            <text x="246" y="128" text-anchor="middle" fill="#c8f560" stroke="none">mTLS</text>

            <!-- Callouts -->
            <g fill="#c8f560" stroke="none">
              <text x="300" y="240">01  HARDWARE   yours, stays yours</text>
              <text x="300" y="262">02  SOFTWARE   open source, Apache 2.0</text>
              <text x="300" y="284">03  DATA       never leaves the building</text>
              <text x="300" y="306">04  TELEMETRY  none</text>
            </g>
            <line x1="300" y1="318" x2="470" y2="318" stroke-opacity="0.4"/>

            <!-- Title block -->
            <g transform="translate(0 360)">
              <line x1="0" y1="0" x2="520" y2="0"/>
              <line x1="340" y1="0" x2="340" y2="80"/>
              <line x1="430" y1="0" x2="430" y2="80"/>
              <line x1="0" y1="40" x2="520" y2="40"/>
              <g fill="#c8f560" stroke="none">
                <text x="12" y="16" fill-opacity="0.6">DRAWN BY</text>
                <text x="12" y="31" font-size="12">FAULKNER ENGINEERING LLC</text>
                <text x="352" y="16" fill-opacity="0.6">DWG NO.</text>
                <text x="352" y="31" font-size="12">FE-0001</text>
                <text x="442" y="16" fill-opacity="0.6">REV</text>
                <text x="442" y="31" font-size="12">A</text>
                <text x="12" y="56" fill-opacity="0.6">TITLE</text>
                <text x="12" y="71" font-size="11">SOFTWARE FOR PEOPLE WHO RUN THEIR OWN MACHINES</text>
                <text x="352" y="56" fill-opacity="0.6">SCALE</text>
                <text x="352" y="71" font-size="12">1:1</text>
                <text x="442" y="56" fill-opacity="0.6">LICENSE</text>
                <text x="442" y="71" font-size="12">APACHE 2.0</text>
              </g>
            </g>
          </svg>
        </div>
      </div>
    </section>

    <!-- Products -->
    <section id="products" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
        <div class="mb-12 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-accent">Products</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Your workstation is a VM</h2>
          </div>
          <p class="max-w-md text-muted">Keep the PC a PC. Put the work in virtual machines you can reach, move, and back up.</p>
        </div>

        <article class="overflow-hidden rounded-3xl border border-line bg-panel">
          <div class="grid lg:grid-cols-[1fr_1.35fr]">
            <div class="p-6 sm:p-10">
              <img src="/hyperharbor/lockup-on-dark.svg" alt="HyperHarbor" class="h-9 w-auto sm:h-10" width="210" height="40">
              <p class="mt-6 text-lg leading-relaxed text-muted text-pretty">
                Manage Hyper-V virtual machines on a home PC and connect to them in one click from any device. Open source under Apache&nbsp;2.0.
              </p>
              <ul class="mt-6 space-y-2 font-mono text-sm text-muted">
                {hyperharborFeatures.map((f) => (
                  <li class="flex gap-3"><span class="text-dim">—</span>{f}</li>
                ))}
              </ul>
              <div class="mt-8 flex flex-wrap gap-3">
                <a href="/hyperharbor" class="rounded-full bg-fg px-5 py-2.5 text-sm font-semibold text-ink transition-opacity hover:opacity-90">
                  Learn more
                </a>
                <a href={repo} class="rounded-full border border-line px-5 py-2.5 text-sm font-semibold transition-colors hover:border-fg/40">
                  View on GitHub
                </a>
              </div>
              <p class="mt-6 font-mono text-xs text-dim">Windows 11 Pro host · Apache 2.0</p>
            </div>
            <div class="border-t border-line lg:border-l lg:border-t-0">
              <img src="/hyperharbor/client-dark.webp" alt="The HyperHarbor client listing virtual machines on a host, with a VM's actions menu open" class="h-full w-full object-cover object-right-top" width="1600" height="800" loading="lazy">
            </div>
          </div>
        </article>

        <p class="mt-8 font-mono text-sm text-dim">More tools are on the way. Follow the <a href={repo} class="text-muted underline decoration-line underline-offset-4 transition-colors hover:text-accent">GitHub organization</a> to see them land.</p>
      </div>
    </section>

    <!-- Approach -->
    <section id="approach" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
        <p class="font-mono text-xs uppercase tracking-widest text-accent">Approach</p>
        <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
          Small team, senior hands, no black boxes.
        </h2>

        <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
          {principles.map((p, i) => (
            <li class="border-t border-line pt-6">
              <p class="font-mono text-sm text-dim">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-3 text-lg font-semibold">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{p.body}</p>
            </li>
          ))}
        </ol>

        <div class="mt-20">
          <p class="font-mono text-xs uppercase tracking-widest text-dim">Built with</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {stack.map((t) => (
              <li class="rounded-full border border-line px-4 py-1.5 font-mono text-sm text-muted">{t}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
        <div class="mb-12 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-accent">Services</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">Consulting, in limited doses</h2>
          </div>
          <p class="max-w-md text-muted">We take on a small number of engagements a year in data platforms and applied AI, when the fit is right.</p>
        </div>

        <div class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
          {services.map((s) => (
            <article class="group bg-ink p-8 transition-colors hover:bg-panel">
              <p class="font-mono text-sm text-dim transition-colors group-hover:text-accent">{s.n}</p>
              <h3 class="mt-4 text-lg font-semibold tracking-tight">{s.title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{s.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-32">
        <div class="rounded-3xl border border-line bg-panel p-6 sm:p-14">
          <p class="font-mono text-xs uppercase tracking-widest text-accent">Contact</p>
          <h2 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-balance sm:text-5xl">
            Running HyperHarbor, or have a project in mind? Say hello.
          </h2>
          <p class="mt-6 max-w-xl text-lg text-muted">
            Bug reports and feature ideas go to <a href={`${repo}/issues`} class="text-fg underline decoration-line underline-offset-4 transition-colors hover:text-accent">GitHub issues</a>. Everything else, email us. We reply within two business days.
          </p>
          <a href="mailto:contact@faulkner.engineering" class="group mt-10 inline-flex items-center gap-3 text-lg font-medium sm:text-2xl">
            <span class="border-b border-accent/50 pb-1 transition-colors group-hover:border-accent group-hover:text-accent">contact@faulkner.engineering</span>
            <span class="text-accent transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

</Site>

<style>
    .flow { animation: dash 2s linear infinite; }
    @keyframes dash { to { stroke-dashoffset: -16; } }
    .led { animation: blink 2s ease-in-out infinite; }
    @keyframes blink { 50% { opacity: 0.2; } }
  </style>
