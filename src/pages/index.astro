---
import '../styles/global.css'

const year = new Date().getFullYear();

const services = [
  {
    n: '01',
    title: 'Data platform architecture',
    body: 'Lakehouse and warehouse designs that fit how your business actually uses data, not how a vendor demo does.',
    items: ['Platform assessments', 'Lakehouse & medallion design', 'Governance and cost controls'],
  },
  {
    n: '02',
    title: 'Pipelines & ingestion',
    body: 'Batch and streaming ingestion that is observable, idempotent, and boring in the best way.',
    items: ['Source-to-lakehouse ingestion', 'SQL & Spark transformation', 'Orchestration and monitoring'],
  },
  {
    n: '03',
    title: 'Applied AI',
    body: 'Practical AI built on top of clean data: retrieval, automation, and analytics that ship past the prototype.',
    items: ['LLM & RAG integrations', 'ML-ready feature data', 'Evaluation and guardrails'],
  },
  {
    n: '04',
    title: 'Team enablement',
    body: 'Workshops and pairing so your engineers own the system after the engagement ends.',
    items: ['Hands-on workshops', 'Code review & mentorship', 'Runbooks and documentation'],
  },
];

const steps = [
  { title: 'Assess', body: 'Map your sources, systems, and the decisions the data needs to support.' },
  { title: 'Design', body: 'A concrete architecture and plan, sized to your team and budget.' },
  { title: 'Build', body: 'Production code, tested and deployed, in short visible iterations.' },
  { title: 'Hand off', body: 'Docs, training, and a team that is confident running it.' },
];

const stack = ['Databricks', 'Apache Spark', 'Delta Lake', 'SQL', 'Python', 'Azure', 'AWS', 'dbt', 'Airflow'];
---

<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Faulkner Engineering LLC | Data & AI Consulting</title>
  <meta name="description" content="Faulkner Engineering LLC is an independent consultancy for data platform architecture, data pipelines, and applied AI, with hands-on training so your team can own what gets built.">
  <meta name="keywords" content="data engineering, AI consulting, solution architecture, lakehouse, Databricks, data pipelines, data ingestion, engineering education">
  <meta name="author" content="Faulkner Engineering LLC">
  <meta name="theme-color" content="#0c0c0d">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="canonical" href="https://faulkner.engineering/">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://faulkner.engineering/">
  <meta property="og:title" content="Faulkner Engineering LLC | Data & AI Consulting">
  <meta property="og:description" content="Data platforms that hold up in production. Architecture, pipelines, and applied AI, plus the training to run them.">
  <meta property="og:site_name" content="Faulkner Engineering LLC">
  <meta property="og:image" content="https://faulkner.engineering/faulkner-engineering-favicon.png">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary">
  <meta name="twitter:url" content="https://faulkner.engineering/">
  <meta name="twitter:title" content="Faulkner Engineering LLC | Data & AI Consulting">
  <meta name="twitter:description" content="Data platforms that hold up in production. Architecture, pipelines, and applied AI, plus the training to run them.">
  <meta name="twitter:image" content="https://faulkner.engineering/faulkner-engineering-favicon.png">

  <!-- Structured Data -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "name": "Faulkner Engineering LLC",
    "description": "Data platform architecture, data pipelines, applied AI, and engineering education.",
    "url": "https://faulkner.engineering",
    "email": "contact@faulkner.engineering",
    "areaServed": "United States",
    "serviceType": ["Data Engineering", "AI Consulting", "Solution Architecture", "Custom Development", "Engineering Education"]
  }
  </script>
</head>
<body class="min-h-screen">

  <!-- Background grid -->
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-10 bg-grid"></div>

  <!-- Header -->
  <header class="sticky top-0 z-30 border-b border-line/70 bg-ink/80 backdrop-blur-md">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
      <a href="#top" class="flex items-center gap-2.5 font-semibold tracking-tight">
        <img src="/favicon.svg" alt="" class="h-7 w-7" width="28" height="28">
        <span>Faulkner Engineering</span>
      </a>
      <nav class="flex items-center gap-6 text-sm text-muted">
        <a href="#services" class="hidden hover:text-fg sm:inline">Services</a>
        <a href="#approach" class="hidden hover:text-fg sm:inline">Approach</a>
        <a href="#contact" class="rounded-full border border-line px-4 py-1.5 text-fg transition-colors hover:border-accent hover:text-accent">Contact</a>
      </nav>
    </div>
  </header>

  <main id="top">

    <!-- Hero -->
    <section class="mx-auto max-w-6xl px-4 pb-20 pt-16 sm:px-6 sm:pt-24 lg:pb-28">
      <div class="grid items-center gap-12 lg:grid-cols-[1.25fr_1fr]">
        <div>
          <p class="mb-6 inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted">
            <span class="relative flex h-2 w-2">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-60"></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-accent"></span>
            </span>
            Taking on new projects
          </p>
          <h1 class="text-4xl font-semibold leading-[1.05] tracking-tight text-balance sm:text-6xl">
            Data platforms that hold up in&nbsp;production.
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted text-pretty">
            Faulkner Engineering is an independent consultancy for data architecture, pipelines, and applied AI, with the hands-on training your team needs to own it after we're done.
          </p>
          <div class="mt-10 flex flex-wrap gap-3">
            <a href="#contact" class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-ink transition-opacity hover:opacity-90">
              Start a conversation
            </a>
            <a href="#services" class="rounded-full border border-line px-6 py-3 text-sm font-semibold transition-colors hover:border-fg/40">
              What we do
            </a>
          </div>
        </div>

        <!-- Pipeline panel -->
        <div aria-hidden="true" class="rounded-2xl border border-line bg-panel/80 font-mono text-[13px] shadow-2xl shadow-black/40">
          <div class="flex items-center justify-between border-b border-line px-4 py-3 text-dim">
            <span>pipeline.run</span>
            <span class="text-accent">● healthy</span>
          </div>
          <ol class="space-y-0 p-4">
            <li class="stage flex items-center justify-between rounded-lg px-3 py-2.5">
              <span><span class="text-dim">01</span>&nbsp; ingest <span class="text-dim">← sources</span></span>
              <span class="text-accent">✓</span>
            </li>
            <li class="stage flex items-center justify-between rounded-lg px-3 py-2.5">
              <span><span class="text-dim">02</span>&nbsp; bronze <span class="text-dim">raw, append-only</span></span>
              <span class="text-accent">✓</span>
            </li>
            <li class="stage flex items-center justify-between rounded-lg px-3 py-2.5">
              <span><span class="text-dim">03</span>&nbsp; silver <span class="text-dim">cleaned, conformed</span></span>
              <span class="text-accent">✓</span>
            </li>
            <li class="stage flex items-center justify-between rounded-lg px-3 py-2.5">
              <span><span class="text-dim">04</span>&nbsp; gold <span class="text-dim">business-ready</span></span>
              <span class="text-accent">✓</span>
            </li>
            <li class="stage flex items-center justify-between rounded-lg px-3 py-2.5">
              <span><span class="text-dim">05</span>&nbsp; serve <span class="text-dim">→ BI · AI · apps</span></span>
              <span class="text-accent">✓</span>
            </li>
          </ol>
          <div class="border-t border-line px-4 py-3 text-dim">
            <span class="text-fg">0</span> failed &nbsp;·&nbsp; <span class="text-fg">0</span> surprises
          </div>
        </div>
      </div>
    </section>

    <!-- Services -->
    <section id="services" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
        <div class="mb-12 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
          <div>
            <p class="font-mono text-xs uppercase tracking-widest text-accent">Services</p>
            <h2 class="mt-3 text-3xl font-semibold tracking-tight sm:text-4xl">What we work on</h2>
          </div>
          <p class="max-w-md text-muted">From the first raw file landing in storage to the dashboard or model that uses it.</p>
        </div>

        <div class="grid gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-2">
          {services.map((s) => (
            <article class="group bg-ink p-8 transition-colors hover:bg-panel">
              <p class="font-mono text-sm text-dim transition-colors group-hover:text-accent">{s.n}</p>
              <h3 class="mt-4 text-xl font-semibold tracking-tight">{s.title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{s.body}</p>
              <ul class="mt-6 space-y-2 font-mono text-sm text-muted">
                {s.items.map((i) => (
                  <li class="flex gap-3"><span class="text-dim">—</span>{i}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Approach -->
    <section id="approach" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-28">
        <p class="font-mono text-xs uppercase tracking-widest text-accent">Approach</p>
        <h2 class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight sm:text-4xl">
          Small team, senior hands, no black boxes.
        </h2>

        <ol class="mt-14 grid gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-8">
          {steps.map((step, i) => (
            <li class="border-t border-line pt-6">
              <p class="font-mono text-sm text-dim">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="mt-3 text-lg font-semibold">{step.title}</h3>
              <p class="mt-2 leading-relaxed text-muted">{step.body}</p>
            </li>
          ))}
        </ol>

        <div class="mt-20">
          <p class="font-mono text-xs uppercase tracking-widest text-dim">Tools we work with</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {stack.map((t) => (
              <li class="rounded-full border border-line px-4 py-1.5 font-mono text-sm text-muted">{t}</li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="border-t border-line">
      <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 lg:py-32">
        <div class="rounded-3xl border border-line bg-panel p-6 sm:p-14">
          <p class="font-mono text-xs uppercase tracking-widest text-accent">Contact</p>
          <h2 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-balance sm:text-5xl">
            Got a data problem that keeps coming back? Let's fix it for good.
          </h2>
          <p class="mt-6 max-w-xl text-lg text-muted">
            Tell us a bit about your stack and what's getting in the way. We'll reply within two business days.
          </p>
          <a href="mailto:contact@faulkner.engineering" class="group mt-10 inline-flex items-center gap-3 text-lg font-medium sm:text-2xl">
            <span class="border-b border-accent/50 pb-1 transition-colors group-hover:border-accent group-hover:text-accent">contact@faulkner.engineering</span>
            <span class="text-accent transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </section>

  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-6xl flex-col justify-between gap-2 px-4 py-8 font-mono text-xs text-dim sm:flex-row sm:px-6">
      <p>© {year} Faulkner Engineering LLC</p>
      <p>Based in the United States · Working remotely</p>
    </div>
  </footer>

<style>
  .bg-grid {
    background-image:
      linear-gradient(to right, rgb(255 255 255 / 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 0%, black 30%, transparent 100%);
  }

  .stage {
    animation: stage-light 6s ease-in-out infinite;
  }
  .stage:nth-child(2) { animation-delay: 1.2s; }
  .stage:nth-child(3) { animation-delay: 2.4s; }
  .stage:nth-child(4) { animation-delay: 3.6s; }
  .stage:nth-child(5) { animation-delay: 4.8s; }

  @keyframes stage-light {
    0%, 22%, 100% { background-color: transparent; }
    8% { background-color: rgb(200 245 96 / 0.08); }
  }
</style>
</body>
</html>
