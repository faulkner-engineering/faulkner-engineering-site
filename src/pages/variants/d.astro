---
import Hero from './_Hero.astro';
---
<Hero title="D · Mark">
  <div aria-hidden="true" class="relative mx-auto aspect-square w-full max-w-[460px]">
    <!-- glow -->
    <div class="absolute inset-0 rounded-full bg-accent/10 blur-3xl"></div>

    <!-- outer orbit -->
    <svg viewBox="0 0 460 460" class="absolute inset-0 orbit-slow" fill="none" font-family="ui-monospace, monospace" font-size="11" letter-spacing="2">
      <defs><path id="o1" d="M230 230 m-200 0 a200 200 0 1 1 400 0 a200 200 0 1 1 -400 0"/></defs>
      <circle cx="230" cy="230" r="200" stroke="#26262a"/>
      <text fill="#9a9aa1"><textPath href="#o1" startOffset="2%">OPEN SOURCE</textPath></text>
      <text fill="#9a9aa1"><textPath href="#o1" startOffset="27%">NO TELEMETRY</textPath></text>
      <text fill="#9a9aa1"><textPath href="#o1" startOffset="52%">BUILT DAILY</textPath></text>
      <text fill="#9a9aa1"><textPath href="#o1" startOffset="77%">YOUR HARDWARE</textPath></text>
      <circle cx="430" cy="230" r="4" fill="#c8f560"/>
    </svg>

    <!-- inner orbit -->
    <svg viewBox="0 0 460 460" class="absolute inset-0 orbit-fast" fill="none">
      <circle cx="230" cy="230" r="140" stroke="#26262a" stroke-dasharray="3 7"/>
      <circle cx="230" cy="90" r="3" fill="#ededed"/>
      <circle cx="230" cy="370" r="3" fill="#ededed" opacity="0.4"/>
    </svg>

    <!-- mark -->
    <img src="/favicon.svg" alt="" class="absolute left-1/2 top-1/2 h-[200px] w-[200px] -translate-x-1/2 -translate-y-1/2 drop-shadow-[0_20px_60px_rgba(0,0,0,0.6)]">

    <p class="absolute inset-x-0 -bottom-8 text-center font-mono text-xs text-dim">est. Madison, WI · faulkner.engineering</p>
  </div>
  <style>
    .orbit-slow { animation: spin 90s linear infinite; transform-origin: 50% 50%; }
    .orbit-fast { animation: spin 30s linear infinite reverse; transform-origin: 50% 50%; }
    @keyframes spin { to { transform: rotate(360deg); } }
  </style>
</Hero>
