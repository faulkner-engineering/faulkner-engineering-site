---
import Hero from './_Hero.astro';
---
<Hero title="C · Terminal">
  <div aria-hidden="true" class="overflow-hidden rounded-2xl border border-line bg-[#0a0a0b] font-mono text-[13px] leading-6 shadow-2xl shadow-black/40">
    <div class="flex items-center gap-2 border-b border-line px-4 py-3">
      <span class="h-3 w-3 rounded-full bg-line"></span>
      <span class="h-3 w-3 rounded-full bg-line"></span>
      <span class="h-3 w-3 rounded-full bg-line"></span>
      <span class="ml-3 text-dim">tyler@faulkner.engineering</span>
    </div>
    <pre id="term" class="min-h-[300px] whitespace-pre-wrap p-5 text-muted"></pre>
  </div>
  <script is:inline>
    const lines = [
      ['$ ', 'fe whoami', 'cmd'],
      ['', 'Faulkner Engineering LLC', 'fg'],
      ['', '  based     Madison, WI', ''],
      ['', '  builds    software for people who run their own machines', ''],
      ['', '  ships     open source, Apache 2.0', ''],
      ['', '  believes  your hardware stays yours', ''],
      ['', '', ''],
      ['$ ', 'fe ls products', 'cmd'],
      ['', '  hyperharbor   v0.2.0   shipped', 'ok'],
      ['', '  next          --       on the bench', ''],
      ['', '', ''],
      ['$ ', '', 'cursor'],
    ];
    const el = document.getElementById('term');
    let i = 0;
    const colors = { cmd: '#ededed', fg: '#ededed', ok: '#c8f560' };
    function typeLine() {
      if (i >= lines.length) return;
      const [prompt, text, kind] = lines[i++];
      const row = document.createElement('div');
      const p = document.createElement('span'); p.textContent = prompt; p.style.color = '#6b6b72';
      const t = document.createElement('span'); if (colors[kind]) t.style.color = colors[kind];
      row.append(p, t); el.append(row);
      if (kind === 'cursor') { const c = document.createElement('span'); c.className = 'cursor'; c.textContent = '█'; row.append(c); return; }
      if (kind === 'cmd') {
        let j = 0;
        const iv = setInterval(() => { t.textContent = text.slice(0, ++j); if (j >= text.length) { clearInterval(iv); setTimeout(typeLine, 250); } }, 45);
      } else { t.textContent = text; setTimeout(typeLine, 90); }
    }
    setTimeout(typeLine, 400);
  </script>
  <style>
    .cursor { color: #c8f560; animation: blink 1s steps(2) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
  </style>
</Hero>
